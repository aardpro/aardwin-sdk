# aardwin example environment.
# Register a site at https://aard.win to obtain your siteId + clientSecret.

# siteId is public — readable by both the browser (<aardwin-auth>) and the server
# (callback + dashboard). The api origin defaults to https://api.aard.win; no override needed.
VITE_AARDWIN_SITE_ID=

# Server-only secret (NEVER ship to the browser). Used by the callback + dashboard APIs.
AARDWIN_CLIENT_SECRET=

# Optional callback path passed to <aardwin-auth callback-path> in the login view.
# When set (non-empty), the SDK appends return_url to the bff redirect URL. When left
# empty (default), the SDK does not send return_url and the bff falls back to the
# callbackUrl registered for the site in the aardwin console.
VITE_AARDWIN_CALLBACK_PATH=/callback

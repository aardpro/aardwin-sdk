# --- server-only (used by app/callback/route.ts; NEVER expose to the browser) ---

# Register a site at https://aard.win to obtain your siteId + clientSecret.
AARDWIN_SITE_ID=
# Server-only secret (NEVER ship to the browser)
AARDWIN_CLIENT_SECRET=
# aardwin api origin. Leave BLANK to target the public api https://api.aard.win.
# Only fill this in when pointing at your own self-hosted or test aardwin api.
AARDWIN_API_ORIGIN=

# --- browser-public (used by app/login/page.tsx via NEXT_PUBLIC_) ---
# siteId is safe to expose (it is public). Copy the same AARDWIN_SITE_ID here.
# Same for the api origin: leave BLANK to use https://api.aard.win, or mirror
# AARDWIN_API_ORIGIN above when pointing at your own api.
NEXT_PUBLIC_AARDWIN_SITE_ID=
NEXT_PUBLIC_AARDWIN_API_ORIGIN=

# aardwin example environment.
# Register a site at https://aard.win to obtain your siteId + clientSecret.

# siteId is public — readable by both the browser (<aardwin-auth>) and the server
# (callback + dashboard). The api origin defaults to https://api.aard.win; no override needed.
NEXT_PUBLIC_AARDWIN_SITE_ID=

# Server-only secret (NEVER ship to the browser). Used by the callback + dashboard routes.
AARDWIN_CLIENT_SECRET=
